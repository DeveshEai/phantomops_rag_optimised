# .env.example — Sally Configuration Template
# Copy this file to .env and fill in your values before running.

# ── Data folders (all optional) ───────────────────────────────────────────────
# By default PhantomOps keeps everything INSIDE this delivery folder (no setting
# needed). To relocate any of them (e.g. onto a shared drive), uncomment and set
# an absolute path (use forward slashes even on Windows, e.g. C:/PhantomOps/output,
# not C:\PhantomOps\output) — these now take effect:
#   DATABASE_DIR  where phantomops.db and the RAG knowledge base (chroma_db) live.
#                 Shared across version_N delivery folders sitting beside each
#                 other by default (same convention as the shared .venv, see
#                 install.bat) — a new release connects to the SAME history and
#                 knowledge base instead of starting over empty.
#   OUTPUT_DIR    downloaded attachments and generated files
#   ASSETS_DIR    templates / letterhead / logo / images PhantomOps uses
#   INTAKE_DIR    "drop a file here for PhantomOps to process" folder
#                 (defaults to OUTPUT_DIR\intake — follows OUTPUT_DIR if unset)
#   DELIVERY_DIR  where PhantomOps writes deliverables when asked to save (not email)
#                 (defaults to OUTPUT_DIR itself — follows OUTPUT_DIR if unset)
# DATABASE_DIR=C:/PhantomOps/database
# ASSETS_DIR=C:/PhantomOps/assets
# OUTPUT_DIR=C:/PhantomOps/output

# ── LLM providers (set at least ONE — Sally is model-agnostic) ───────────────
# Only providers with a key are enabled; the agent falls back across them.
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Web Search APIs ──────────────────────────────────────────────────────────
SERPAPI_KEY=your_serpapi_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite only — all data lives in DATABASE_DIR/phantomops.db. No DB server or Redis.

# ── Outlook / Microsoft Graph API (email_provider is set in agent_config.yaml) ─
# Run `python skills/email_skill/setup_outlook_oauth.py` once to authenticate.
OUTLOOK_CLIENT_ID=your_client_id_here
OUTLOOK_CLIENT_SECRET=your_client_secret_here
OUTLOOK_TENANT_ID=your_tenant_id_here

# ── Gmail API (email_provider is set in agent_config.yaml) ───────────────────
# Create an OAuth "Desktop app" client in Google Cloud Console and paste its
# Client ID / Secret below — mirrors OUTLOOK_CLIENT_ID/_SECRET, no file needed.
# Run `python skills/email_skill/setup_gmail_oauth.py` (or Gmail-Connector\run.bat)
# to create gmail_token.json.
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
# GMAIL_TOKEN_PATH=C:/PhantomOps/gmail_token.json

EMAIL_POLL_INTERVAL=30

# ── Settings Dashboard ───────────────────────────────────────────────────────
DASHBOARD_PASSWORD=sally2026
