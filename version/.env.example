# ============================================================
#  PhantomOps Version 4 — Outlook build (native Windows, NO Docker)
# ============================================================
# ── Data folders (all optional) ───────────────────────────────────────────────
# By default PhantomOps keeps everything INSIDE this delivery folder (no setting
# needed). To relocate any of them (e.g. onto a shared drive), uncomment and set
# an absolute path (use forward slashes even on Windows, e.g. C:/PhantomOps/output,
# not C:\PhantomOps\output) — these now take effect:
#   DATABASE_DIR  where phantomops.db and the RAG knowledge base (chroma_db) live.
#                 Shared across version_N delivery folders sitting beside each
#                 other by default (same convention as the shared .venv, see
#                 install.bat) — a new release connects to the SAME history and
#                 knowledge base instead of starting over empty.
#   OUTPUT_DIR    downloaded attachments and generated files
#   ASSETS_DIR    templates / letterhead / logo / images PhantomOps uses
#   INTAKE_DIR    "drop a file here for PhantomOps to process" folder
#                 (defaults to OUTPUT_DIR\intake — follows OUTPUT_DIR if unset)
#   DELIVERY_DIR  where PhantomOps writes deliverables when asked to save (not email)
#                 (defaults to OUTPUT_DIR itself — follows OUTPUT_DIR if unset)

DATABASE_DIR="C:/path/to/phantomops/database"

ASSETS_DIR="C:/path/to/phantomops/assets"

OUTPUT_DIR="C:/path/to/phantomops/output"

INTAKE_DIR="C:/path/to/phantomops/intake"

DELIVERY_DIR="C:/path/to/phantomops/delivery"

# Name of the SQLite data file inside DATABASE_DIR (history, tasks, watermark).
DB_FILENAME=phantomops.db

# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Groq is required. Claude, Gemini, OpenAI are optional — add a key to enable.

GROQ_API_KEY="your_groq_api_key_here"
ANTHROPIC_API_KEY=
GOOGLE_API_KEY="your_google_api_key_here"
OPENAI_API_KEY=

# ── Web Search APIs ───────────────────────────────────────────────────────────
SERPAPI_KEY="your_serpapi_key_here"
TAVILY_API_KEY="your_tavily_api_key_here"

# ── Storage: SQLite only — data lives in DATABASE_DIR/phantomops.db. No DB server. ────

# Outlook (email_provider is set in agent_config.yaml). Fill these from your Azure app
# registration (Mail.Send + Mail.Read, and Calendars.ReadWrite if you use
# meeting scheduling):
OUTLOOK_CLIENT_ID = your-azure-client-id
OUTLOOK_CLIENT_SECRET = your-azure-client-secret
OUTLOOK_TENANT_ID = your-azure-tenant-id
# outlook_token.txt (the signed-in mailbox token) must sit next to start.bat.
# Generate/refresh it via Outlook-Connector\run.bat.

# Gmail (email_provider is set in agent_config.yaml). Create an OAuth "Desktop app" client
# in Google Cloud Console and paste its Client ID / Secret here — see
# Gmail-Connector\instructions.txt for the one-time setup steps.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# gmail_token.json (the signed-in mailbox token) must sit next to start.bat.
# Generate/refresh it via Gmail-Connector\run.bat.

EMAIL_POLL_INTERVAL=30
